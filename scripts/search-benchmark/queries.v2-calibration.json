  "review": {
    "method": "Independently reviewed all 320 manifest images in 16 newly generated split-specific contact sheets, verifying each file against source.sha256 and displaying the actual manifest sample ID. Inspected ambiguous originals. Whole-query judgments come from visible image content, not goldTags, source titles, model scores or search results.",
    "reviewedAt": "2026-10-08",
    "granularity": "Visible objects, scenes and compound attributes; unresolved fine detail remains unjudged. Transparent images were checked against originals because white contact-sheet backgrounds can hide white lettering.",
    "splitRule": "Reuse the manifest near-duplicate cluster split: 160 development images and 160 holdout images; judgments never cross splits.",
    "contactSheets": "reports/search-optimization/calibration-contact-sheets-20261008",
    "previousContactSheets": "Existing audit/tag-benchmark-v2/contact-sheets/v2-* sheets were rejected for sample-ID mapping because several displayed IDs do not match the current manifest originals.",
    "independence": "60 new natural-language queries, 30 for calibration and 30 for validation, prepared without viewing their model scores or returned results. Images were already used in earlier work; this is query independence on existing material, not an unseen-image or new-library acceptance set.",
    "status": "frozen-before-model-evaluation",
    "labelPolicy": "Do not change queries, positives, hard negatives or unjudged judgments in response to model results; report newly discovered annotation defects separately before any versioned correction."
  },
