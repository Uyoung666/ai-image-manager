{
  "name": "ai-image-manager",
  "productName": "AI Image Manager",
  "version": "1.0.0-beta",
  "description": "100% 本地 AI 图片管理器 — 自然语言搜索、智能去重、自动标签、人脸识别、云端分享",
  "main": ".vite/build/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "chcp 65001 > nul & electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "bump-ui": "ts-node ./scripts/bump-ui.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node ./scripts/migrate.ts",
    "postinstall": "node scripts/postinstall-cleanup.mjs && electron-rebuild -f -w better-sqlite3,@lancedb/lancedb,@xenova/transformers"
  },
  "author": "Uyoung",
  "license": "MIT",
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.34.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@lancedb/lancedb": "^0.18.2",
    "@orpc/client": "^1.13.14",
    "@orpc/server": "^1.13.14",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.2",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/leaflet": "^1.9.21",
    "@xenova/transformers": "^2.17.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.44.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.0.0",
    "exifr": "^7.1.3",
    "i18next": "^26.0.3",
    "leaflet": "^1.9.4",
    "lru-cache": "^11.1.0",
    "lucide-react": "^1.14.0",
    "p-queue": "^8.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
    "react-leaflet": "^5.0.0",
    "react-virtuoso": "^4.12.7",
    "recharts": "^2.15.0",
    "shadcn": "^4.1.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "update-electron-app": "^3.1.2",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.4.12",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tanstack/router-plugin": "^1.167.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.0",
    "electron": "^41.1.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-playwright-helpers": "^2.1.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.1",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.3.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "^2"
    },
    "@xenova/transformers": {
      "sharp": "$sharp"
    }
  }
